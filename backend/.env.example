# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Predefined Fixed WhatsApp Destination Number (Include country code without + sign, e.g. 919876543210)
WHATSAPP_DESTINATION_NUMBER=919876543210

# WhatsApp Cloud API Credentials
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_API_VERSION=v18.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_DELIVERY_CONFIG=


